@page
@model VehiculosModel
@{
    ViewData["Title"] = "Vehículos";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Vehículos</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flNombre" 
                placeholder="Nombre"
                asp-for="@Model.Filtro!.Nombre"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Vehículo</h3>

                

                <label>
                    Placa
                </label>
                <input id=nmPlaca"
                    asp-for="@Model.Actual!.Placa"/>
                <br />

                <label>
                  Marca
                </label>
                <input id=nmMarca"
                    asp-for="@Model.Actual!.Marca"/>
                <br />

                <label>
                    Modelo
                </label>
                <input id=nmModelo"
                    asp-for="@Model.Actual!.Modelo"/>
                <br />

                <label>
                   Id_tipo
                </label>
                <input id=nmId_tipo"
                    asp-for="@Model.Actual!.Id_tipo"/>
                <br />

               
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el vehículo con información 
                          
                            @Model.Actual!.Placa,
                            @Model.Actual!.Marca?
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        
                        <th>Placa</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Id_tipo</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Placa</td>
                                <td>@elemento.Marca</td>
                                <td>@elemento.Modelo</td>
                                <td>@elemento.Id_tipo</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>