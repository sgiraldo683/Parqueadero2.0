@page
@model ContratosModel
@{
    ViewData["Title"] = "Contratos";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Contratos</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flNombre" 
                placeholder="Nombre"
                asp-for="@Model.Filtro!.Nombre"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Contrato</h3>

                

                <label>
                    Id_cliente
                </label>
                <input id=nmId_cliente"
                    asp-for="@Model.Actual!.Id_cliente"/>
                <br />

                <label>
                   Id_plan
                </label>
                <input id=nmId_plan"
                    asp-for="@Model.Actual!.Id_plan"/>
                <br />

                <label>
                    Fecha_inicio
                </label>
                <input id=nmfecha_inicio"
                    asp-for="@Model.Actual!.fecha_inicio"/>
                <br />

                <label>
                   Fecha_fin
                </label>
                <input id=nmTelefono"
                    asp-for="@Model.Actual!.Telefono"/>
                <br />

               
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el contrato con información 
                          
                            @Model.Actual!.Id_cliente,
                            @Model.Actual!.Id_plan?
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        
                        <th>Id_cliente</th>
                        <th>Id_plan</th>
                        <th>Fecha_inicio</th>
                        <th>Fecha_fin</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id_cliente</td>
                                <td>@elemento.Id_plan</td>
                                <td>@elemento.Fecha_inicio</td>
                                <td>@elemento.Fecha_fin</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>