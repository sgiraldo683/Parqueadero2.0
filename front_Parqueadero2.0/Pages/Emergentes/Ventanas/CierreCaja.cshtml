@page
@model CierreCajaModel
@{
    ViewData["Title"] = "Cierre de Caja";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Cierre de Caja</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flNombre" 
                placeholder="Nombre"
                asp-for="@Model.Filtro!.Nombre"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Cierre de Caja</h3>

                

                <label>
                    Numero
                </label>
                <input id=nmNumero"
                    asp-for="@Model.Actual!.Numero"/>
                <br />

                <label>
                   Fecha_apertura
                </label>
                <input id=nmFechaApertura"
                    asp-for="@Model.Actual!.Fecha_apertura"/>
                <br />

                <label>
                    Saldo_inicial
                </label>
                <input id=nmSaldoInicial"
                    asp-for="@Model.Actual!.Saldo_inicial"/>
                <br />

                <label>
                   Saldo_final
                </label>
                <input id=nmSaldoFinal"
                    asp-for="@Model.Actual!.Saldo_final"/>
                <br />

               
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el cierre de caja con información 
                          
                            @Model.Actual!.Numero,
                            @Model.Actual!.Fecha_apertura?
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        
                        <th>Numero</th>
                        <th>Fecha_apertura</th>
                        <th>Saldo_inicial</th>
                        <th>Saldo_final</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Numero</td>
                                <td>@elemento.Fecha_apertura</td>
                                <td>@elemento.Saldo_inicial</td>
                                <td>@elemento.Saldo_final</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>